# Copy this file to backend/.env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Powers the chat assistant (LangGraph agent). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Powers bank linking. Free Sandbox keys, issued instantly, no review needed:
# https://dashboard.plaid.com/signup -> Team Settings -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Encrypts Plaid access tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
